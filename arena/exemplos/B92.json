  "gabarito": "algoritmo \"B92_Telemetria\"\n\nvar\n    i, m : inteiro\n\nfuncao maior(lista)\n    m <- lista[0]\n    para i de 1 até (tamanho(lista) - 1) faça\n        se lista[i] > m então\n            m <- lista[i]\n        fim_se\n    fim_para\n    retorne m\nfim_funcao\n\ninicio\n    escreva(maior([3, 9, 2]))\nfim_algoritmo\n"
