{
  "name": "meupia-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test 'src/**/*.test.js' && python3 -m pytest -q tests",
    "test:js": "node --test 'src/**/*.test.js'",
    "test:py": "python3 -m pytest -q tests",
    "validar": "python3 scripts/validar_desafios.py",
    "local": "npm run build && ARENA_MODO=ensaio ADMIN_TOKEN=admin python3 scripts/servidor_local.py",
    "offline": "npm run build && python3 scripts/iniciar_offline.py"
  },
  "devDependencies": {
    "vite": "^8.3.3"
  },
  "overrides": {
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.2",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "marked": "^17.0.4"
  }
